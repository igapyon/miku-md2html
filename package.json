{
  "name": "miku-md2html",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "description": "Convert Markdown and local images into a self-contained HTML document.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "miku-md2html": "bundle/miku-md2html.mjs"
  },
  "exports": {
    ".": "./bundle/miku-md2html-runtime.mjs"
  },
  "scripts": {
    "build": "node scripts/generate-viewer-assets.mjs && tsc --noEmit",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "cli": "npm run build:bundle --silent && node bundle/miku-md2html.mjs",
    "build:bundle": "node scripts/generate-viewer-assets.mjs && node scripts/generate-third-party-notices.mjs && node scripts/build-bundles.mjs",
    "licenses": "node scripts/generate-third-party-notices.mjs",
    "build:all": "npm run build && npm run build:bundle",
    "smoke:bundle": "node scripts/smoke-cli-bundle.mjs",
    "smoke:runtime": "node scripts/smoke-runtime-bundle.mjs",
    "release:stage": "node scripts/prepare-release-assets.mjs",
    "smoke:release-assets": "node scripts/smoke-release-assets.mjs",
    "smoke:all": "npm run build:all && npm run smoke:bundle && npm run smoke:runtime && npm run release:stage && npm run smoke:release-assets"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.10",
    "css-tree": "^3.1.0",
    "hast-util-to-html": "^9.0.5",
    "highlight.js": "11.11.1",
    "image-size": "^2.0.2",
    "lowlight": "3.3.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/css-tree": "^2.3.10",
    "@types/mdast": "4.0.4",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "hast-util-from-html": "2.0.3",
    "tar": "^7.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
